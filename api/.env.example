PORT=4000
# debug | info | warn | error | silent. Set SLOW_REQUEST_MS=0 to disable slow-request warnings.
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
JWT_SECRET=replace-with-a-long-random-secret-before-use
WEB_ORIGIN=http://localhost:5173
# Local MongoDB (installed as a Windows service). For Vercel use a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=invento
# Set to false to stop creating the demo account on an empty database.
SEED_DEMO=true
